# Authentication. "clerk" in production; "local-dev" is refused when NODE_ENV=production.
DEVANALYTICS_AUTH_MODE=local-dev
DEVANALYTICS_LOCAL_ORG_ID=

# Database. Leave DATABASE_URL unset to use the embedded Postgres 16 engine.
# DATABASE_URL=postgresql://user:pass@host:5432/devanalytics
DEVANALYTICS_EMBEDDED_DATA_DIR=./.pgdata

# Secret encryption. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVANALYTICS_ENCRYPTION_KEY=

DEVANALYTICS_BASE_URL=http://localhost:3117

# Optional. Without a key, answers are assembled from evidence and cost nothing.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional. Redis fronts the durable Postgres queue for lower dispatch latency.
# REDIS_URL=redis://localhost:6379

# Optional, for Clerk session verification.
# CLERK_SECRET_KEY=
